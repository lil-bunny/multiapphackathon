# Unipile (mail)
UNIPILE_API_KEY=
UNIPILE_DSN=api11.unipile.com:14157
UNIPILE_ACCOUNT_ID=
UNIPILE_ACCOUNT_EMAIL=
DELIVERY_FOLLOWUP_DELAY_SECONDS=10
# Optional — leave empty; webhook accepts requests without x-webhook-secret
UNIPILE_WEBHOOK_SECRET=

# Google Sheets CRM
# Service account JSON from Google Cloud (type=service_account) — do not commit the file
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
GOOGLE_SHEET_ID=

# Slack incoming webhook (delay alerts)
SLACK_WEBHOOK_URL=

# OpenAI (reply classification)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# POC mode: use in-memory CRM/mail/slack (eval + local dev without credentials)
FIXTURE_MODE=false

# Public tunnel (optional — for Unipile webhook registration)
NGROK_DOMAIN=
